# =============================================================================
# Rapid X AI Voice Agent - environment configuration
# Copy this file to `.env` and fill in real values.
# =============================================================================

# ----- LiveKit (cloud project) -----
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Worker log level. info (default) is what LiveKit observability captures;
# crank to debug for incident analysis, warning for noisy long-running ops.
# Levels: debug, info, warning, error, critical.
LIVEKIT_LOG_LEVEL=info

# ----- Voice stack -----
# gemini: native audio-to-audio.
# cascade: streaming Deepgram STT -> Groq LLM -> Sarvam TTS.
VOICE_STACK=gemini

# ----- Gemini Live (Google) -----
# Prefer GEMINI_API_KEY. Do not set both unless they are the same key.
GEMINI_API_KEY=
GOOGLE_API_KEY=
# Default is the production-recommended native-audio model. Tier 2 swap
# candidate: gemini-2.5-flash-live (faster, less natural prosody).
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
# Voices: Puck, Charon, Kore, Fenrir, Aoede, Leda, Orus, Zephyr
GEMINI_VOICE=Puck
GEMINI_TEMPERATURE=0.8
REALTIME_PROMPT_TOKEN_TARGET=300
VOICE_METRICS_LOG=/tmp/voice-agent-metrics.jsonl
# Per-call audio recordings (caller side). One WAV per room.
# Make sure the directory exists and has enough disk: ~4 MB per minute at 16kHz mono.
VOICE_RECORDINGS_DIR=/opt/livekit-ai-voice/recordings

# ----- Tier 3 cascade providers -----
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=multi
DEEPGRAM_ENDPOINTING_MS=25

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.35
GROQ_MAX_COMPLETION_TOKENS=80

SARVAM_API_KEY=
SARVAM_TTS_MODEL=bulbul:v2
SARVAM_LANGUAGE=en-IN
SARVAM_SPEAKER=anushka
SARVAM_SAMPLE_RATE=16000
SARVAM_PACE=1.08
SARVAM_TEMPERATURE=0.6
SARVAM_MIN_BUFFER_SIZE=30
SARVAM_MAX_CHUNK_LENGTH=80
SARVAM_OUTPUT_AUDIO_BITRATE=64k
SARVAM_ENABLE_PREPROCESSING=true

CASCADE_MIN_ENDPOINTING_DELAY=0.2
CASCADE_MAX_ENDPOINTING_DELAY=0.8

# ----- Vobiz SIP provider -----
SIP_TRUNK_ID=
SIP_DOMAIN=
SIP_USERNAME=
SIP_PASSWORD=
SIP_OUTBOUND_NUMBER=
SIP_ANSWER_TIMEOUT_SECONDS=90

# Backward-compat: VOBIZ_* names are mirrored in the current Vobiz setup.
VOBIZ_SIP_TRUNK_ID=
VOBIZ_SIP_DOMAIN=
VOBIZ_USERNAME=
VOBIZ_PASSWORD=
VOBIZ_OUTBOUND_NUMBER=

# Optional default transfer destination for the `transfer_call` tool.
DEFAULT_TRANSFER_NUMBER=

# Optional Supabase persistence (call logs / recordings).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_S3_BUCKET=call-recordings

# Dashboard
PORT=3000
HOST=0.0.0.0
AGENT_NAME=outbound-caller
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=

# GitHub deploy webhook
# GitHub webhook URL: https://call-agent.protechplanner.com/api/deploy/github
# Generate a long random value and use the same value as the GitHub webhook secret.
DEPLOY_WEBHOOK_SECRET=
DEPLOY_RUNNER=auto
DEPLOY_REPO_DIR=/opt/livekit-ai-voice
DEPLOY_BRANCH=main
DEPLOY_REMOTE=origin
DEPLOY_WORKER_SERVICE=livekit-agent.service
DEPLOY_DASHBOARD_SERVICE=livekit-dashboard.service
DEPLOY_LOG=/opt/livekit-ai-voice/logs/deploy.log
EXPECTED_LIVEKIT_REGION=India West
