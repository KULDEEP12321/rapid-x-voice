{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "api-pipe",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-07",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "dev": {
    "port": 4000
  },
  "minify": true,
  "observability": {
    "enabled": true
  },
  "vars": {
    "BASE_URL": "http://localhost:4000",
    "FRONTEND_URL": "http://localhost:3000",
    "BETTER_AUTH_URL": "http://localhost:4000",
    "PYTHON_DISPATCH_URL": "https://call-agent.protechplanner.com/api/dispatch",
    "GROQ_BASE_URL": "https://api.groq.com/openai/v1",
    "GROQ_MODEL": "llama-3.3-70b-versatile"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "app",
      "database_id": "6dd7ba47-b6d4-464d-8c29-fb8683649a9f",
      "preview_database_id": "6dd7ba47-b6d4-464d-8c29-fb8683649a9f"
    }
  ],
  "env": {
    "development": {
      "vars": {
        "BASE_URL": "http://localhost:4000",
        "FRONTEND_URL": "http://localhost:3000",
        "BETTER_AUTH_URL": "http://localhost:4000",
        "PYTHON_DISPATCH_URL": "https://call-agent.protechplanner.com/api/dispatch",
        "GROQ_BASE_URL": "https://api.groq.com/openai/v1",
        "GROQ_MODEL": "llama-3.3-70b-versatile"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "app",
          "database_id": "6dd7ba47-b6d4-464d-8c29-fb8683649a9f",
          "preview_database_id": "6dd7ba47-b6d4-464d-8c29-fb8683649a9f"
        }
      ]
    },
    "production": {
      "vars": {
        "BASE_URL": "",
        "FRONTEND_URL": "",
        "BETTER_AUTH_URL": "",
        "PYTHON_DISPATCH_URL": "https://call-agent.protechplanner.com/api/dispatch",
        "GROQ_BASE_URL": "https://api.groq.com/openai/v1",
        "GROQ_MODEL": "llama-3.3-70b-versatile"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "app",
          "database_id": "6dd7ba47-b6d4-464d-8c29-fb8683649a9f",
          "preview_database_id": "6dd7ba47-b6d4-464d-8c29-fb8683649a9f"
        }
      ]
    }
  }
}
